# Virtual Environment
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# macOS / OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Sensitive & Confidential Uploads
# Protects personal insurance policy certificates from accidental commit
uploads/contracts/*
!uploads/contracts/.gitkeep

# Temporary / Intermediate runtime files (regenerated by agents)
temp/*
!temp/.gitkeep

# Generated analysis reports (regenerated by agents)
reports/*
!reports/.gitkeep

# Editor & IDE configs
.idea/
.vscode/
*.swp
*.swo

